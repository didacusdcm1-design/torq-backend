generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  CUSTOMER
  RIDER
  ADMIN
}

enum TripStatus {
  REQUESTED
  ACCEPTED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

model User {
  id             String         @id @default(uuid())
  currentLat     Float?
  currentLng     Float?
  isOnline       Boolean        @default(false)
  phone          String?        @unique
  email          String?        @unique
  password       String?
  otpCode        String?
  role           Role           @default(CUSTOMER)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  riderProfile   RiderProfile?
  customerTrips  Trip[]         @relation("TripCustomer")
  riderTrips     Trip[]         @relation("TripRider")
  wallet         Wallet?
  notifications  Notification[]
}

model RiderProfile {
  id                String   @id @default(uuid())
  userId            String   @unique
  fullName          String?
  nationalId        String?
  licenseNumber     String?
  emergencyContact  String?
  bikeMake          String?
  bikeModel         String?
  bikeColor         String?
  bikeReg           String?
  selfieUrl         String?
  licenseDocUrl     String?
  verificationStatus String  @default("PENDING_REVIEW")
  user              User     @relation(fields: [userId], references: [id])
}

model Trip {
  id            String        @id @default(uuid())
  pickupPin     String?       @default("0000")
  distanceKm    Float?        @default(0)
  durationMins  Int?          @default(0)
  pickupLat     Float
  pickupLng     Float
  dropoffLat    Float
  dropoffLng    Float
  estimatedFare Float
  finalFare     Float?
  status        TripStatus    @default(REQUESTED)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  customerId    String
  customer      User          @relation("TripCustomer", fields: [customerId], references: [id])
  riderId       String?
  rider         User?         @relation("TripRider", fields: [riderId], references: [id])
  ledgerEntries LedgerEntry[]
}

model LedgerEntry {
  id        String   @id @default(uuid())
  tripId    String
  trip      Trip     @relation(fields: [tripId], references: [id])
  entryType String
  amount    Float
  createdAt DateTime @default(now())
}

model PricingRule {
  id             String   @id @default(uuid())
  baseFare       Float    @default(50)
  perKmRate      Float    @default(30)
  perMinuteRate  Float    @default(5)
  commissionRate Float    @default(0.15)
  updatedAt      DateTime @updatedAt
}

model Wallet {
  id      String  @id @default(uuid())
  userId  String  @unique
  balance Float   @default(0)
  user    User    @relation(fields: [userId], references: [id])
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  message   String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id])
}
