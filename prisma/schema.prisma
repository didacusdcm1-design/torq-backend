generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  CUSTOMER
  RIDER
  ADMIN
}

enum TripStatus {
  REQUESTED
  ACCEPTED
  IN_PROGRESS
  ARRIVED_AT_PICKUP
  IN_PROGRESS_DEST
  COMPLETED
  CANCELLED
}

model User {
  id             String         @id @default(uuid())
  currentLat     Float?
  currentLng     Float?
  isOnline       Boolean        @default(false)
  phone          String?        @unique
  email          String?        @unique
  password       String?
  otpCode        String?
  role           Role           @default(CUSTOMER)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  riderProfile   RiderProfile?
  customerTrips  Trip[]         @relation("TripCustomer")
  riderTrips     Trip[]         @relation("TripRider")
  wallet         Wallet?
  notifications  Notification[]
}

model RiderProfile {
  id                 String   @id @default(uuid())
  userId             String   @unique
  fullName           String?
  nationalId         String?
  licenseNumber      String?
  emergencyContact   String?
  bikeMake           String?
  bikeModel          String?
  bikeColor          String?
  bikeReg            String?
  selfieUrl          String?
  licenseDocUrl      String?
  verificationStatus String   @default("PENDING_REVIEW")
  user               User     @relation(fields: [userId], references: [id])
}

model Trip {
  id            String        @id @default(uuid())
  pickupPin     String?       @default("0000")
  distanceKm    Float?        @default(0)
  durationMins  Int?          @default(0)
  pickupLat     Float
  pickupLng     Float
  dropoffLat    Float
  dropoffLng    Float
  estimatedFare Float
  finalFare     Float?
  status        TripStatus    @default(REQUESTED)
  rating        Int?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  customerId    String
  customer      User          @relation("TripCustomer", fields: [customerId], references: [id])
  riderId       String?
  rider         User?         @relation("TripRider", fields: [riderId], references: [id])
  ledgerEntries LedgerEntry[]
  cancelledBy        String?
  cancellationReason String?
  cancellationNote   String?
}

model LedgerEntry {
  id        String   @id @default(uuid())
  tripId    String
  trip      Trip     @relation(fields: [tripId], references: [id])
  entryType String
  amount    Float
  createdAt DateTime @default(now())
}

model PricingRule {
  id             String   @id @default(uuid())
  baseFare       Float    @default(50)
  perKmRate      Float    @default(30)
  perMinuteRate  Float    @default(5)
  commissionRate Float    @default(0.15)
  updatedAt      DateTime @updatedAt
}

model Wallet {
  id      String  @id @default(uuid())
  userId  String  @unique
  balance Float   @default(0)
  user    User    @relation(fields: [userId], references: [id])
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  message   String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id])
}

model ServiceArea {
  id        String   @id @default(uuid())
  name      String
  city      String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
}

model PromoCode {
  id            String   @id @default(uuid())
  code          String   @unique
  discountType  String   @default("FIXED")
  discountValue Float
  isActive      Boolean  @default(true)
  usageLimit    Int?
  timesUsed     Int      @default(0)
  createdAt     DateTime @default(now())
}

model SupportTicket {
  id          String   @id @default(uuid())
  ticketRef   String   @unique
  subject     String
  description String
  status      String   @default("OPEN")
  priority    String   @default("MEDIUM")
  userId      String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}
model SafetyIncident {
  id          String   @id @default(uuid())
  incidentRef String   @unique
  type        String   // SOS, ACCIDENT, HARASSMENT, SUSPICIOUS
  description String
  status      String   @default("OPEN") // OPEN, INVESTIGATING, RESOLVED
  severity    String   @default("HIGH") // LOW, MEDIUM, HIGH, CRITICAL
  reporterId  String?  // Link to user if known
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}
model Dispute {
  id          String   @id @default(uuid())
  disputeRef  String   @unique
  tripId      String?
  subject     String
  description String
  amount      Float    @default(0)
  status      String   @default("OPEN") // OPEN, UNDER_REVIEW, RESOLVED, REJECTED
  priority    String   @default("MEDIUM")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}
model AuditLog {
  id        String   @id @default(uuid())
  actorId   String?
  action    String
  entity    String
  entityId  String?
  details   String?
  createdAt DateTime @default(now())
}