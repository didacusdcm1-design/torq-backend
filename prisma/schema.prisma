generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  CUSTOMER
  RIDER
  ADMIN
}

enum TripStatus {
  REQUESTED
  ACCEPTED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

model User {
  id             String         @id @default(uuid())
  phone          String?        @unique
  email          String?        @unique
  password       String?
  otpCode        String?
  role           Role           @default(CUSTOMER)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  riderProfile   RiderProfile?
  customerTrips  Trip[]         @relation("TripCustomer")
  riderTrips     Trip[]         @relation("TripRider")
  wallet         Wallet?
  notifications  Notification[]
}

model RiderProfile {
  id        String @id @default(uuid())
  userId    String @unique
  user      User   @relation(fields: [userId], references: [id])
}

model Trip {
  id            String     @id @default(uuid())
  pickupPin     String?    @default("0000")
  distanceKm    Float?     @default(0)
  durationMins  Int?       @default(0)
  pickupLat     Float
  pickupLng     Float
  dropoffLat    Float
  dropoffLng    Float
  estimatedFare Float
  finalFare     Float?
  status        TripStatus @default(REQUESTED)
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
  customerId    String
  customer      User       @relation("TripCustomer", fields: [customerId], references: [id])
  riderId       String?
  rider         User?      @relation("TripRider", fields: [riderId], references: [id])
}

model Wallet {
  id      String  @id @default(uuid())
  userId  String  @unique
  balance Float   @default(0)
  user    User    @relation(fields: [userId], references: [id])
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  message   String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id])
}
